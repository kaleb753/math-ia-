import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import interp1d

# Data and Model Coefficients (Replace with your actual data)
data = {
    "Height (cm)": [0, 4, 6, 8, 10.5],  # Release heights
    "β0": [-1.099, -1.099, -1.099, -1.099, -1.099],  # Intercept
    "β1": [0, 0.01459, 0.03404, 0.01475, 0.03432],  # Coefficient for height
    "β2": [0.2418, 0.1629, 0.3525, -0.02122, 0.1494],  # Coefficient for distance
    "β3": [-0.000961, 0.003048, 0, -0.0004733, -0.004359],  # Coefficient for angle
}

# Interpolation functions for coefficients
f_beta1 = interp1d(data["Height (cm)"], data["β1"])
f_beta2 = interp1d(data["Height (cm)"], data["β2"])
f_beta3 = interp1d(data["Height (cm)"], data["β3"])

# Define ranges for shooting distance and angle
distances = np.linspace(0, 3, 50)  # Shooting distances (0m to 3m)
angles = np.linspace(-90, 90, 45)  # Shooting angles (-100° to 100°)

# Create a meshgrid for distance and angle
distance_grid, angle_grid = np.meshgrid(distances, angles)

# Function to calculate probability based on the logistic regression model
def calculate_probability(height, distance, angle):
    beta1 = f_beta1(height)
    beta2 = f_beta2(height)
    beta3 = f_beta3(height)
    log_odds = data["β0"][0] + beta1*height + beta2*distance + beta3*angle #using beta0 for height 0
    probability = 1 / (1 + np.exp(-log_odds))
    return probability

# Generate heatmaps for each release height with normalized probabilities
heights = [0, 4, 6, 8, 10.5] #using discrete heights
for height in heights:
  probabilities = calculate_probability(height, distance_grid, angle_grid)

  # Normalize probabilities to the range [0, 1]
  normalized_probs = (probabilities - probabilities.min()) / (probabilities.max() - probabilities.min())

  plt.figure(figsize=(8, 6))
  plt.imshow(
      normalized_probs,  # Use normalized probabilities for plotting
      extent=[angles.min(), angles.max(), distances.min(), distances.max()],  # Corrected extent
      aspect="auto",
      origin="lower",
      cmap="YlGnBu",  
  )
  plt.colorbar(label="Probability of Scoring (Normalized)")  # Update colorbar label
  plt.xlabel("Shooting Angle (degrees)")
  plt.ylabel("Shooting Distance (m)")
  plt.title(f"Heatmap for Release Height = {height}cm")

  # Set x-axis ticks to show -100 and 100
  plt.xticks(np.linspace(angles.min(), angles.max(), 5))  # Adjust the number 5 for more/less ticks
  # or plt.xticks([-90, -45, 0, 45, 90])  
  plt.show()
