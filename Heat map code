import numpy as np
import matplotlib.pyplot as plt

# Assume you have collected data and fitted a logistic regression model
# The coefficients from your model are stored in the 'data' dictionary
data = {
    "Height (cm)": [0, 4, 6, 8, 10.5],  # Release heights
    "β0": [-1.099, -1.099, -1.099, -1.099, -1.099],  # Intercept
    "β1": [0, 0.01459, 0.03404, 0.01475, 0.03432],  # Coefficient for height
    "β2": [0.2418, 0.1629, 0.3525, -0.02122, 0.1494],  # Coefficient for distance
    "β3": [-0.000961, 0.003048, 0, -0.0004733, -0.004359],  # Coefficient for angle
}

# Interpolate β3 for 8cm (if needed) - this part can be adjusted 
# based on your data analysis and model fitting
#data['β3'][data['Height (cm)'].index(8)] = np.interp(8, [data['Height (cm)'][i] for i in [1, -2]], [data['β3'][i] for i in [1,-2]])


# Define ranges for shooting distance and angle
distances = np.linspace(1, 3, 50)  # Shooting distances (1m to 3m)
angles = np.linspace(-90, 90, 50)  # Shooting angles (-90° to 90°)

# Create a meshgrid for distance and angle
distance_grid, angle_grid = np.meshgrid(distances, angles)

# Function to calculate probability based on the logistic regression model
def calculate_probability(height, distance, angle):
    h_idx = data["Height (cm)"].index(height)  # Get index for height
    β0, β1, β2, β3 = data["β0"][h_idx], data["β1"][h_idx], data["β2"][h_idx], data["β3"][h_idx]
    log_odds = β0 + β1 * height + β2 * distance + β3 * angle
    probability = 1 / (1 + np.exp(-log_odds))
    return probability

# Generate heatmaps for each release height
for height in data["Height (cm)"]:
    probabilities = calculate_probability(height, distance_grid, angle_grid)

    plt.figure(figsize=(8, 6))
    plt.imshow(
        probabilities,
        extent=[distances.min(), distances.max(), angles.min(), angles.max()],
        aspect="auto",
        origin="lower",
        cmap="YlGnBu",  # Choose a suitable colormap
    )
    plt.colorbar(label="Probability of Scoring")
    plt.xlabel("Shooting Distance (m)")
    plt.ylabel("Shooting Angle (degrees)")
    plt.title(f"Heatmap for Release Height = {height}cm")
    plt.show()
